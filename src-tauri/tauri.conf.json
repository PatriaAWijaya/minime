{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 640,
        "minWidth": 1024,
        "title": "Minime",
        "width": 1280
      }
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../src",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../assets/app-icon.jpg"
    ],
    "resources": {
      "../assets/avatars/*": "avatars/"
    },
    "targets": "all"
  },
  "identifier": "id.minime.app",
  "productName": "Minime",
  "version": "0.1.0"
}