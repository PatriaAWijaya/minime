{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "label": "main",
        "minHeight": 640,
        "minWidth": 1024,
        "resizable": true,
        "title": "Minime",
        "width": 1280
      }
    ]
  },
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "../../skills"
    ],
    "publisher": "Patria A. Wijaya",
    "homepage": "https://github.com/PatriaAWijaya/minime",
    "category": "Productivity",
    "shortDescription": "Tim kerja AI di komputermu — Mimi + 5 agen spesialis",
    "copyright": "© 2026 Patria A. Wijaya",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "identifier": "id.minime.app",
  "productName": "Minime",
  "version": "0.1.0"
}
