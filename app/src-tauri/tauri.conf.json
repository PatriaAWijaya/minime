{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "label": "main",
        "minHeight": 640,
        "minWidth": 1024,
        "resizable": true,
        "title": "Minime",
        "width": 1280
      }
    ]
  },
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "../../skills"
    ]
  },
  "identifier": "id.minime.app",
  "productName": "Minime",
  "version": "0.1.0"
}