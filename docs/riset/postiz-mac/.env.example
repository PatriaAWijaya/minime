# ============================================================
# Contoh konfigurasi postiz-app untuk MacBook Patria
# Cara pakai: salin file ini menjadi ".env" di folder yang sama,
# lalu isi nilai yang bertanda WAJIB. Jangan commit file .env asli.
#   cp .env.example .env
# ============================================================

# ---------- WAJIB: keamanan ----------
# JWT_SECRET: string acak panjang untuk menandatangani sesi login.
# WAJIB diganti — buat dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Password database Postgres internal (boleh default untuk pemakaian lokal,
# tapi disarankan diganti).
POSTGRES_PASSWORD=postiz-password

# ---------- WAJIB: matikan registrasi publik setelah akun admin dibuat ----------
# Biarkan 'false' saat pertama kali install (agar bisa daftar akun admin),
# lalu ubah menjadi 'true' dan restart setelah akun admin jadi.
DISABLE_REGISTRATION=false

# ---------- Kredensial platform sosial (isi sesuai kebutuhan) ----------
# Setiap platform butuh "developer app" sendiri. Yang kosong boleh
# dibiarkan kosong — platform itu tidak bisa dihubungkan sampai diisi.
# Instagram & Facebook lewat aplikasi Meta yang SAMA (developers.facebook.com).
# Panduan per platform ada di INSTALL_MAC.md bagian 5.

# X (Twitter) — https://developer.x.com
X_URL=
X_API_KEY=
X_API_SECRET=

# LinkedIn — https://developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Threads — pakai Meta App yang sama dengan Facebook/Instagram
THREADS_APP_ID=
THREADS_APP_SECRET=

# Facebook + Instagram — https://developers.facebook.com (satu app untuk keduanya)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# YouTube — https://console.cloud.google.com (OAuth client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# TikTok Business (opsional, untuk akun bisnis)
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=

# Pinterest — https://developers.pinterest.com
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---------- Opsional ----------
# AI generatif di dalam postiz (untuk bantu tulis caption) — boleh kosong.
OPENAI_API_KEY=

# Batas request API per menit (default 30, cukup untuk pemakaian Minime).
API_LIMIT=30

# Mastodon (default publik; ganti bila punya instance sendiri)
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
